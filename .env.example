# Copy this file to .env.local and fill in your own values.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# --- Supabase (Project Settings → API Keys, or the "Connect" button) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Daily expiry scan (Vercel Cron) ---
# Server-only "service_role" / secret key: lets the 8 am cron job read the data with no user logged in.
# NEVER put NEXT_PUBLIC_ in front of it and never share it.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random text. Vercel sends it with every cron call so nobody else can start the scan.
CRON_SECRET=

# --- Email alerts (optional – Nodemailer over SMTP, e.g. Gmail with an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Who gets the daily summary (comma-separated). Empty = every Admin's email.
ALERT_EMAIL_TO=
# Optional "From" name, e.g. ExpiryGuard <you@gmail.com>
ALERT_EMAIL_FROM=
# Link in the email, e.g. https://expiryguard.vercel.app
APP_URL=
